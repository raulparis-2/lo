{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/keep-alive", "schedule": "0 9 * * *" }
  ],
  "redirects": [
    { "source": "/supabase/:path*", "destination": "/", "permanent": false },
    { "source": "/.github/:path*", "destination": "/", "permanent": false },
    { "source": "/LEEME.md", "destination": "/", "permanent": false },
    { "source": "/DESPLEGAR-VERCEL.md", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/lb-e148a28a.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
